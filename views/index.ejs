     <script>
    window.MathJax = {
      tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']], // Allow $ for inline
        displayMath: [['$$', '$$'], ['\\[', '\\]']] // Allow $$ for block
      },
      svg: {
        fontCache: 'global'
      }
    };
    </script>

    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
