<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Note: Generative Replay | Harikrishna Pillai</title>
    <link rel="stylesheet" href="../styles.css">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.7/katex.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.7/katex.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pseudocode@latest/build/pseudocode.min.css">
    <script src="https://cdn.jsdelivr.net/npm/pseudocode@latest/build/pseudocode.min.js"></script>
    <!-- <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script> -->
     
</head>
<body class="single-note-page">

    <nav class="note-nav">
        <a href="/" class="back-link">&larr; Return to Index</a>
    </nav>

    <main class="reading-container">
        <header class="note-header">
            <div class="note-meta">Published: <%= date %> &bull; Category: <%= category %></div>
            <h1><%= title %></h1>
        </header>

        <article class="note-content">
            <% if (abstract) { %>
                <div class="abstract">
                    <strong>Abstract:</strong> <%= abstract %>
                </div>
            <% } %>
            <br>

            <div class="markdown-body">
                <%- content %>
            </div>
        </article>

        <footer class="note-footer">
            <hr>
            <p>Harikrishna Pillai &copy; 2024</p>
        </footer>
    </main>
    
   <script>
    window.MathJax = {
      tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']], // Allow $ for inline
        displayMath: [['$$', '$$'], ['\\[', '\\]']] // Allow $$ for block
      },
      svg: {
        fontCache: 'global'
      }
    };
    </script>
    
    <script>
    document.addEventListener("DOMContentLoaded", function() {
        document.querySelectorAll("pre code.language-algorithm, pre code.language-pseudocode").forEach(block => {
            const pre = block.parentElement;
            const algoDiv = document.createElement("div");
            try {
                // pseudocode.js does not support \label, so we strip it out before rendering
                const cleanedContent = block.textContent.replace(/\\label\{[^}]*\}/g, '');
                pseudocode.render(cleanedContent, algoDiv, { mathEngine: 'katex', lineNumber: true });
                pre.parentNode.replaceChild(algoDiv, pre);
            } catch (e) {
                console.error("Pseudocode evaluation error:");
                console.error(e.message || e);
                console.error("Stack:", e.stack);
                console.error("Text content was:", JSON.stringify(block.textContent));
                // Keep the original block if algorithm parsing fails
            }
        });
    });
    </script>

    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

</body>
</html>